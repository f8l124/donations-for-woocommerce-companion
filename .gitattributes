# Enforce LF line endings across the repo regardless of contributor OS.
# Eliminates the CRLF→LF warnings on Windows checkouts and keeps PR diffs
# stable.

* text=auto eol=lf

# Source files — explicit (defensive).
*.php  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf

# Binaries.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text eol=lf
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.zip  binary
*.gz   binary

# Linguist hints.
assets/blocks/recurring-donation/index.js linguist-vendored=false
*.spec.ts linguist-detectable=true

# Files that should NOT ship in the wp.org distribution zip (also in .distignore).
.github/         export-ignore
.wolf/           export-ignore
.claude/         export-ignore
plans/           export-ignore
tests/           export-ignore
docs/            export-ignore
scripts/         export-ignore
.wp-env.json     export-ignore
.wp-env.*.json   export-ignore
playwright.config.ts export-ignore
.distignore      export-ignore
.gitattributes   export-ignore
.gitignore       export-ignore
package.json     export-ignore
package-lock.json export-ignore
