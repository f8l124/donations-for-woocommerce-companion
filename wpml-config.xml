<?xml version="1.0" encoding="UTF-8"?>
<wpml-config>
    <!--
    WPML compatibility declaration for Donations for WooCommerce Companion.
    See plans/v2/AA-wpml-integration.md for the full integration spec.

    This file is read by WPML on plugin activation and on WPML's cache rebuilds.
    The companion does NOT register the wc-donation post type — the parent
    plugin owns it. WPML's WooCommerce Multilingual already handles
    wc-donation translation natively.
    -->

    <!-- Custom fields the companion writes to wc-donation campaign posts. -->
    <!-- action="copy" means: WPML copies the value verbatim from source to -->
    <!-- translation. Our config blobs (intervals, presets, amounts) are -->
    <!-- structurally identical across translations; the strings INSIDE the -->
    <!-- blobs are translated separately via WPML String Translation under -->
    <!-- the "Donations Companion" domain. -->
    <custom-fields>
        <!-- v0.6.x meta keys (legacy; resolver still reads as fallback). -->
        <custom-field action="copy">_dfwc_companion_intervals</custom-field>
        <custom-field action="copy">_dfwc_companion_display</custom-field>

        <!-- v0.7.0 meta keys — Phase 3 layered config model. -->
        <custom-field action="copy">_dfwc_companion_template_id</custom-field>
        <custom-field action="copy">_dfwc_companion_overrides</custom-field>
        <custom-field action="copy">_dfwc_companion_detached</custom-field>
    </custom-fields>

    <!-- Admin texts: option-stored strings that should appear in WPML's -->
    <!-- String Translation UI for translators to handle. The dotted nesting -->
    <!-- mirrors the option's array structure. -->
    <admin-texts>
        <key name="dfwc_companion_global_settings">
            <key name="display">
                <key name="cause_heading"/>
            </key>
            <key name="one_time">
                <key name="cta_template"/>
                <key name="subtitle"/>
                <key name="annual_equivalency"/>
            </key>
            <key name="monthly">
                <key name="cta_template"/>
                <key name="subtitle"/>
                <key name="annual_equivalency"/>
            </key>
            <key name="annual">
                <key name="cta_template"/>
                <key name="subtitle"/>
                <key name="annual_equivalency"/>
            </key>
        </key>
    </admin-texts>

    <!-- Custom taxonomies (Phase 4 — v0.8.0). -->
    <!-- translate="1" means each taxonomy term is itself translatable. -->
    <!-- Reserved for Phase 4; entries will be uncommented when taxonomies register. -->
    <taxonomies>
        <!-- <taxonomy translate="1">dfwc_cause</taxonomy> -->
        <!-- <taxonomy translate="1">dfwc_region</taxonomy> -->
        <!-- <taxonomy translate="1">dfwc_country</taxonomy> -->
        <!-- <taxonomy translate="1">dfwc_program</taxonomy> -->
        <!-- <taxonomy translate="1">dfwc_sponsorship_type</taxonomy> -->
        <!-- <taxonomy translate="1">dfwc_urgency</taxonomy> -->
    </taxonomies>
</wpml-config>
