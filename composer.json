{
    "name": "f8l124/donations-for-woocommerce-companion",
    "description": "Companion plugin adding interval-first recurring donation support to Donation for WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "David Stells",
            "homepage": "https://github.com/f8l124"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/woocommerce-stubs": "^9.4",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint:php": "find includes templates donations-for-woocommerce-companion.php -name '*.php' -print0 | xargs -0 -n1 php -l",
        "lint:phpcs": "phpcs",
        "fix:phpcbf": "phpcbf",
        "analyze": "phpstan analyse --memory-limit=512M",
        "test:unit": "phpunit",
        "test:contract": "php tests/parent-contract.test.php",
        "check": [
            "@lint:phpcs",
            "@analyze",
            "@test:unit"
        ]
    },
    "scripts-descriptions": {
        "lint:php": "Run PHP linter on all production PHP files",
        "lint:phpcs": "Run PHP_CodeSniffer with WordPress Coding Standards",
        "fix:phpcbf": "Auto-fix PHPCS violations where possible",
        "analyze": "Run PHPStan static analysis at level 5",
        "test:unit": "Run PHPUnit unit tests",
        "test:contract": "Run parent-plugin contract watcher",
        "check": "Run all CI gates (PHPCS + PHPStan + unit tests)"
    }
}
